<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.util.*" %><%@ page import="com.hospital.HospitalServlet" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hospital Dashboard</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><header class="topbar"><a class="brand" href="<%=request.getContextPath()%>/app/">✚ HospitalCare</a><span>Management Portal</span><a class="logout" href="<%=request.getContextPath()%>/app/logout">Sign out</a></header><main class="container"><div class="hero"><div><p class="eyebrow">HOSPITAL OPERATIONS</p><h1>Dashboard</h1><p class="muted">Manage hospital records from one place.</p></div><div class="hero-mark">✚</div></div><% String flash=(String)session.getAttribute("flash");if(flash!=null){%><div class="alert"><%=flash%></div><%session.removeAttribute("flash");}%><section class="cards"><% Collection<?> modules=(Collection<?>)request.getAttribute("modules");for(Object obj:modules){String title=String.valueOf(obj.getClass().getField("title").get(obj));String key=String.valueOf(obj.getClass().getField("key").get(obj));%><a class="module-card" href="<%=request.getContextPath()%>/app/<%=key%>"><span class="card-icon">✚</span><strong><%=title%></strong><span class="card-arrow">Open →</span></a><%}%></section><p class="footnote">Educational demo only. Use fictional records; not approved for clinical use.</p></main></body></html>
