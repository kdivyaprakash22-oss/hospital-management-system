<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hospital Management Login</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body class="login-page"><main class="login-card"><div class="brand-icon">✚</div><h1>Hospital Management</h1><p class="muted">Sign in to the demo administration portal</p><% String error=(String)session.getAttribute("loginError"); if(error!=null){%><div class="alert"><%=error%></div><%session.removeAttribute("loginError");}%><form method="post" action="<%=request.getContextPath()%>/login"><label>Username<input name="username" autocomplete="username" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="primary" type="submit">Sign in</button></form><p class="hint">Set APP_USERNAME and APP_PASSWORD in your hosting environment before starting the app.</p></main></body></html>
